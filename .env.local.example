# Create a Supabase project at https://supabase.com/dashboard
# Then copy these values from Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Where "Report this link" on share pages sends mail. The link renders only
# when this is set — publishing an address has a spam cost, so it is opt-in.
NEXT_PUBLIC_REPORT_EMAIL=hello@elulabs.com
